# /opt/election/etc/election.env へコピーし、chmod 600で保護する。
DJANGO_SETTINGS_MODULE=config.settings.production

ELECTION_SECRET_KEY=replace-with-a-long-random-value
ELECTION_ALLOWED_HOSTS=vote.pasj.jp
ELECTION_CSRF_TRUSTED_ORIGINS=https://vote.pasj.jp
ELECTION_SECURE_HSTS_SECONDS=3600

ELECTION_DB_NAME=election
ELECTION_DB_USER=election
ELECTION_DB_PASSWORD=replace-with-database-password
ELECTION_DB_HOST=localhost
ELECTION_DB_PORT=5432

ELECTION_EMAIL_HOST=smtp.example.jp
ELECTION_EMAIL_PORT=465
ELECTION_EMAIL_USER=replace-with-smtp-user
ELECTION_EMAIL_PASSWORD=replace-with-smtp-password
ELECTION_EMAIL_USE_SSL=true
ELECTION_EMAIL_USE_TLS=false
ELECTION_FROM_EMAIL=vote@pasj.jp

ELECTION_LDAP_URI=ldaps://ldap.example.jp
ELECTION_LDAP_BASE_DN=ou=people,dc=pasj,dc=jp
ELECTION_LDAP_BIND_DN=replace-with-bind-dn
ELECTION_LDAP_PASSWORD=replace-with-ldap-password

